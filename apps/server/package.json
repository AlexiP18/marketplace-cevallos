{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "vendure dev server",
    "dev:worker": "vendure dev worker",
    "dev:dashboard": "vendure dev dashboard",
    "dev": "vendure dev all",
    "build": "npm run test:architecture && vendure build all",
    "test:architecture": "node --test test/modular-architecture.test.cjs",
    "test:catalog-search": "node test/run-isolated.cjs catalog-search.integration.ts",
    "test:reservation-performance": "ENFORCE_PERFORMANCE=1 node test/run-isolated.cjs marketplace-latency.benchmark.ts",
    "test:checkout-stock": "node test/run-isolated.cjs checkout-stock.integration.ts",
    "build:server": "vendure build server",
    "build:worker": "vendure build worker",
    "build:dashboard": "vendure build dashboard",
    "reset:superadmin": "ts-node src/reset-superadmin-password.ts",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start:general-worker": "MARKETPLACE_WORKER_ROLE=general node ./dist/index-worker.js",
    "start:reservation-worker": "MARKETPLACE_WORKER_ROLE=admission node ./dist/index-worker.js",
    "start": "vendure start all",
    "test:multivendor": "ts-node -T src/test-multivendor.ts",
    "test:seller-profile": "node --test test/seller-profile-update.test.cjs test/administrator-personal-profile.test.cjs",
    "test:warehouse-users": "node --test test/warehouse-users.test.cjs"
  },
  "dependencies": {
    "@vendure/asset-server-plugin": "3.7.3",
    "@vendure/core": "3.7.3",
    "@vendure/dashboard": "3.7.3",
    "@vendure/email-plugin": "3.7.3",
    "@vendure/graphiql-plugin": "3.7.3",
    "@vendure/job-queue-plugin": "^3.7.3",
    "bullmq": "^5.81.5",
    "bwip-js": "^4.11.4",
    "canvas": "^3.2.3",
    "dotenv": "18.0.4",
    "fabric": "^5.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.14",
    "jspdf": "^2.5.1",
    "jsqr": "^1.4.0",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0",
    "pg-query-stream": "^4.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg-query-stream": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@vendure/cli": "3.7.3",
    "shadcn": "^4.23.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "vite": "7.3.6"
  }
}
