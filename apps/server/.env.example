APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=change-this-cookie-secret
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Required outside APP_ENV=dev; origin without a trailing slash
PUBLIC_API_ORIGIN=https://api.example.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=vendure_password
DB_SCHEMA=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6479
REDIS_PASSWORD=
REDIS_PREFIX=vendure-prueba
# Plazo de nuevas reservas, en minutos enteros (1 a 1440). No modifica reservas existentes.
RESERVATION_TTL_MINUTES=45
# all para desarrollo; en despliegue separar admission (stock) y general (preparación, TTL y archivos).
MARKETPLACE_WORKER_ROLE=all
# Opcional: directorio privado compartido por API y Workers, fuera de static/assets.
PRIVATE_JOB_FILES_PATH=
